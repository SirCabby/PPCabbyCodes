// The Windows build's version resource: what Explorer shows in hid.dll's
// Details, so the file in the game's folder says what it is. The Makefile
// passes the version (from VERSION) as PPCC_VERSION_NUMS (1,2,3,0) and
// PPCC_VERSION_STR ("1.2.3").
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION PPCC_VERSION_NUMS
PRODUCTVERSION PPCC_VERSION_NUMS
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_DLL
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", "PPCabbyCodes - a cheat panel for Papers, Please (stands in for hid.dll)"
      VALUE "FileVersion", PPCC_VERSION_STR
      VALUE "InternalName", "PPCabbyCodes"
      VALUE "OriginalFilename", "hid.dll"
      VALUE "ProductName", "PPCabbyCodes"
      VALUE "ProductVersion", PPCC_VERSION_STR
      VALUE "LegalCopyright", "GPL-3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
