# ---- Build output ----
build/
dist/
tests/build/

# ---- IDEs / editors ----
.vs/
.vscode/
.idea/
*.user

# ---- Local build config (your machine's GAME_DIR) ----
config.mk

# ---- Python tooling ----
__pycache__/
*.py[cod]

# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- Misc ----
*.log

# ---- local save backups (never commit a save file) ----
.save-backup-*/

# ---- reverse-engineering artefacts (never commit game data) ----
ghidra_proj/
dump/

# ---- editor tooling (clangd flags) ----
compile_flags.txt
.clangd
